    Main "1" --> "1" Klinik : mengelola
    Main "1" --> "1" InputHelper : membaca input
    Main ..> Pasien : create
    Main ..> Dokter : create
    Klinik "1" o-- "0..10" Pasien : mendaftarkan
    Klinik "1" o-- "0..5" Dokter : mempekerjakan
    Klinik "1" *-- "0..30" Kunjungan : mencatat
    Klinik "1" *-- "3" SortedList : menyimpan data
    Kunjungan "0..*" --> "1" Pasien : milik pasien
    Kunjungan "0..*" --> "1" Dokter : ditangani oleh
    MemilikiKunci <|.. Pasien : realisasi
    MemilikiKunci <|.. Dokter : realisasi
    MemilikiKunci <|.. Kunjungan : realisasi
    SortedList ..> MemilikiKunci : T extends
